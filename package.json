{
  "name": "@tshu-w/pi-agents",
  "version": "0.1.1",
  "description": "Multi-agent runtime for Pi: async agents, dynamic workflows, inter-agent messaging, and a workbench for your Sessions",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tshu-w/pi-agents.git"
  },
  "homepage": "https://github.com/tshu-w/pi-agents#readme",
  "type": "module",
  "bin": {
    "pd": "bin/pd.mjs",
    "pi-agents": "bin/pd.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs"
  ],
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "multi-agent",
    "async-agents",
    "dynamic-workflows",
    "rlm"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 \"tests/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
